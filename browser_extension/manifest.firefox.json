{
  "manifest_version": 2,
  "name": "P-Downloader Integration Module",
  "version": "1.0.6",
  "description": "Ultra download accelerator with in-page video sniffer, HLS streaming capture, and multi-threaded parallel downloads.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdownloader@ultra.download",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "contextMenus",
    "webRequest",
    "downloads",
    "notifications",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "P-Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
