{
  "manifest_version": 2,
  "name": "P-Downloader Integration Module",
  "version": "1.0.7",
  "description": "Ultra download accelerator with in-page video sniffer, HLS streaming capture, and multi-threaded parallel downloads.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdownloader@ultra.download",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "contextMenus",
    "webRequest",
    "downloads",
    "notifications",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "hls.js",
      "youtube-media.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "P-Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-media.js",
        "youtube-page.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media-choices.js",
        "link_capture.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "icons/icon16.png",
    "icons/icon32.png",
    "icons/icon48.png",
    "icons/icon128.png"
  ]
}
