{
  "manifest_version": 3,
  "name": "P-Downloader Integration Module",
  "version": "2.0.0",
  "description": "Ultra download accelerator with in-page video sniffer, HLS streaming capture, and multi-threaded parallel downloads.",
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["video_sniffer.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "P-Downloader Ultra Active"
  }
}
